# =====================================================================
# LAST DAWN - Unreal Engine 5.8 .gitattributes
# Text is normalized; Unreal and binary source assets go to Git LFS.
# Code, .ini, .uproject, .uplugin, .json, .md, .xml, .usf, .ush are NOT LFS.
# =====================================================================

# --- Text ---
* text=auto
*.cpp text diff=cpp
*.h text diff=cpp
*.cs text diff=csharp
*.ini text
*.uproject text
*.uplugin text
*.json text
*.md text
*.xml text
*.usf text
*.ush text
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# --- Unreal assets (LFS) ---
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# --- Future binary source assets (LFS) ---
*.png filter=lfs diff=lfs merge=lfs -text
